const SPREADSHEET_ID = '1SnOqMLc6Dw7BGqdXOwHOFDNi2lnJAytYfdTWcqR7gpk';
const TOKEN = 'push123'; // тот же токен, что и в отжиматоре; можно поменять на свой

// Соответствие короткого типа (из сайта) и точного названия листа в таблице.
// ПРОВЕРЬТЕ И ПОПРАВЬТЕ под реальные названия вкладок, если отличаются!
const SHEET_MAP = {
  pullup:   'подтягивание',
  jump:     'прыжки',
  situp:    'пресс',
  bend:     'наклон',
  shuttle:  'челнок 3х10',
  run30:    '30 метров',
  throw:    'метание',
  shooting: 'стрельба',
  run60:    '60м'
};

function doPost(e) {
  try {
    const params = e.parameter;

    if (params.token !== TOKEN) {
      return respond('error', 'Неверный токен');
    }

    const sheetName = SHEET_MAP[params.type];
    if (!sheetName) {
      return respond('error', 'Неизвестный норматив: ' + params.type);
    }

    const bib = String(params.participant || '').trim();
    const result = params.result;
    if (!bib || result === undefined || String(result).trim() === '') {
      return respond('error', 'Не переданы номер участника или результат');
    }

    const sheet = SpreadsheetApp.openById(SPREADSHEET_ID).getSheetByName(sheetName);
    if (!sheet) {
      return respond('error', 'Лист не найден: ' + sheetName);
    }

    const lastRow = sheet.getLastRow();
    let rowIndex = -1;

    if (lastRow > 0) {
      const colA = sheet.getRange(1, 1, lastRow, 1).getValues();
      for (let i = 0; i < colA.length; i++) {
        if (String(colA[i][0]).trim() === bib) { rowIndex = i + 1; break; }
      }
    }

    const now = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'dd.MM.yyyy HH:mm:ss');

    if (rowIndex !== -1) {
      // участник уже есть в таблице — обновляем результат и время
      sheet.getRange(rowIndex, 2).setValue(result);
      sheet.getRange(rowIndex, 3).setValue(now);
    } else {
      // новая строка
      const newRow = sheet.getLastRow() + 1;
      sheet.getRange(newRow, 1).setValue(bib);
      sheet.getRange(newRow, 2).setValue(result);
      sheet.getRange(newRow, 3).setValue(now);
    }

    return respond('ok', 'Сохранено');
  } catch (err) {
    return respond('error', err.message);
  }
}

function respond(status, message) {
  return ContentService
    .createTextOutput(JSON.stringify({ status: status, message: message }))
    .setMimeType(ContentService.MimeType.JSON);
}






