// Единая точка входа для старых URL отжиманий и длинного бега.
function doPost(e) {
  try {
    var params = gtoRequest_(e);
    var denied = gtoGuard_(params);
    if (denied) return denied;
    if (Array.isArray(params.entries)) {
      if (!params.entries.length || params.entries.some(function(r) { return !r || !String(r.bib || '').trim() || r.total == null || !String(r.total).trim(); })) {
        return gtoJson_({ok:false,error:'Некорректные результаты забега'});
      }
      var lock = LockService.getScriptLock(); lock.waitLock(10000);
      try { return handleLongRun_(e, params); } finally { lock.releaseLock(); }
    }
    var lock = LockService.getScriptLock(); lock.waitLock(10000);
    try { return handlePushup_(e); } finally { lock.releaseLock(); }
  } catch(err) { return gtoJson_({ok:false,error:String(err)}); }
}

function handleLongRun_(e, data) {
  const sheet = SpreadsheetApp
    .openById('1SnOqMLc6Dw7BGqdXOwHOFDNi2lnJAytYfdTWcqR7gpk')
    .getSheetByName('длинная'); // важно: имя листа должно совпадать!



  if (!sheet) throw new Error('Лист не найден: длинная');
  data.entries.forEach(row => {
    const bib = row.bib;
    const result = row.total;
    const colA = sheet.getRange('A:A').getValues();
    const idx = colA.findIndex(r => r[0] == bib);
    if (idx !== -1) {
      sheet.getRange(idx + 1, 2).setValue(result); // столбец B
    } else {
      const newRow = sheet.getLastRow() + 1;
      sheet.getRange(newRow, 1).setValue(bib);
      sheet.getRange(newRow, 2).setValue(result);
    }
  });

  return gtoJson_({ok:true});
}


function sbrosTolkoRuchnyhDannih() {

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheets = ss.getSheets();

  sheets.forEach(sheet => {

    const lastRow = sheet.getLastRow();
    const lastCol = sheet.getLastColumn();

    if (lastRow < 2) return;

    const range = sheet.getRange(2, 1, lastRow - 1, lastCol);
    const formulas = range.getFormulas();

    for (let i = 0; i < formulas.length; i++) {
      for (let j = 0; j < formulas[i].length; j++) {

        if (!formulas[i][j]) {
          range.getCell(i + 1, j + 1).clearContent();
        }

      }
    }

  });

  SpreadsheetApp.getUi().alert("Сброшены только введённые вручную данные. Формулы сохранены.");
}







